FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install timezone data and configure the timezone
RUN apt-get update && \
    apt-get install -y --no-install-recommends tzdata && \
    ln -snf /usr/share/zoneinfo/Asia/Kolkata /etc/localtime && \
    echo "Asia/Kolkata" > /etc/timezone

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        g++ \
        python3 \
        python3-pip \
        python3-venv \
        python3-setuptools \
        cmake \
        ninja-build \
        git \
        ccache \
        gir1.2-goocanvas-2.0 \
        gir1.2-gtk-3.0 \
        qtbase5-dev \
        qtchooser \
        qt5-qmake \
        qtbase5-dev-tools \
        openmpi-bin \
        openmpi-common \
        openmpi-doc \
        libopenmpi-dev \
        mercurial \
        unzip \
        gdb \
        valgrind \
        libxml2 \
        libxml2-dev \
        libboost-all-dev \
        clang-format \
        doxygen \
        graphviz \
        imagemagick \
        texlive \
        texlive-extra-utils \
        texlive-latex-extra \
        texlive-font-utils \
        dvipng \
        latexmk \
        python3-sphinx \
        dia \
        gsl-bin \
        libgsl-dev \
        libgslcblas0 \
        tcpdump \
        sqlite3 \
        libsqlite3-dev \
        libgtk-3-dev \
        vtun \
        lxc \
        uml-utilities \
    && rm -rf /var/lib/apt/lists/*

# Set the application directory
WORKDIR /app

# Copy the project files
COPY . /app/

# Create a virtual environment for Python dependencies
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv "${VIRTUAL_ENV}"

ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# Install Python dependencies
RUN python -m pip install --upgrade pip && \
    python -m pip install -r /app/requirements.txt

# Clone and configure ns-3.48
RUN git clone --branch ns-3.48 --depth 1 \
    https://gitlab.com/nsnam/ns-3-dev.git /app/ns-3-dev

# Install 5G-LENA v5.1
WORKDIR /app/ns-3-dev/contrib

RUN git clone --branch v5.1 --depth 1 \
    https://gitlab.com/cttc-lena/nr.git nr

# Link the project's network simulator into ns-3 scratch
RUN test -d /app/network-simulator && \
    ln -s /app/network-simulator /app/ns-3-dev/scratch/network-simulator

# Configure and compile ns-3
WORKDIR /app/ns-3-dev

ARG NS3_BUILD_JOBS=4

RUN ./ns3 configure --enable-examples --enable-tests -d optimized && \
    ./ns3 build -j "${NS3_BUILD_JOBS}"

# Return to the project directory
WORKDIR /app